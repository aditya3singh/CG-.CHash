@model LpuApplicationForm.Models.StudentModel
@{
    Layout = null;
    var currentYear = DateTime.Now.Year;
    var validUntil = DateTime.Now.AddYears(4).Year;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Student ID Card - @Model.FullName</title>
    <style>
        @@media print {
            .no-print { display: none; }
            body { margin: 0; background: white; }
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            margin: 0;
        }

        .id-card-wrapper {
            perspective: 1500px;
        }

        .id-card {
            width: 380px;
            background: white;
            border-radius: 20px;
            box-shadow: 0 25px 80px rgba(0,0,0,0.4);
            overflow: hidden;
            position: relative;
            transition: transform 0.6s;
        }

        .id-card:hover {
            transform: rotateY(5deg) rotateX(5deg);
        }

        .id-card-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 25px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .id-card-header::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            animation: shimmer 3s infinite;
        }

        @@keyframes shimmer {
            0%, 100% { transform: translate(0, 0); }
            50% { transform: translate(10%, 10%); }
        }

        .university-logo {
            width: 70px;
            height: 70px;
            background: white;
            border-radius: 50%;
            margin: 0 auto 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: 28px;
            background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
            color: #667eea;
            border: 4px solid white;
            box-shadow: 0 5px 20px rgba(0,0,0,0.2);
            position: relative;
            z-index: 1;
        }

        .university-name {
            font-size: 20px;
            font-weight: 800;
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 2px;
            position: relative;
            z-index: 1;
        }

        .university-subtitle {
            font-size: 12px;
            margin: 8px 0 0 0;
            opacity: 0.95;
            position: relative;
            z-index: 1;
        }

        .id-card-body {
            padding: 30px;
            background: white;
            position: relative;
        }

        .student-photo-container {
            text-align: center;
            margin-bottom: 25px;
        }

        .student-photo {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            object-fit: cover;
            border: 5px solid #667eea;
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3);
            background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e0 100%);
        }

        .student-id-number {
            text-align: center;
            font-size: 18px;
            font-weight: 800;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin: 20px 0;
            padding: 12px;
            background-color: #f7fafc;
            border-radius: 10px;
            letter-spacing: 3px;
        }

        .info-section {
            margin-bottom: 15px;
            padding: 12px;
            background: #f7fafc;
            border-radius: 8px;
            border-left: 3px solid #667eea;
        }

        .info-label {
            font-size: 11px;
            color: #718096;
            text-transform: uppercase;
            font-weight: 700;
            margin-bottom: 5px;
            letter-spacing: 0.5px;
        }

        .info-value {
            font-size: 15px;
            color: #2d3748;
            font-weight: 600;
        }

        .id-card-footer {
            background: linear-gradient(135deg, #f7fafc 0%, #edf2f7 100%);
            padding: 20px;
            text-align: center;
            border-top: 3px solid #667eea;
        }

        .validity {
            font-size: 12px;
            color: #4a5568;
            margin-bottom: 15px;
            font-weight: 600;
        }

        .signature-section {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
            padding-top: 15px;
        }

        .signature {
            text-align: center;
            flex: 1;
        }

        .signature-line {
            border-top: 2px solid #2d3748;
            margin-top: 35px;
            padding-top: 8px;
            font-size: 10px;
            color: #718096;
            font-weight: 600;
        }

        .barcode {
            text-align: center;
            margin-top: 15px;
            font-family: 'Courier New', monospace;
            font-size: 24px;
            letter-spacing: 3px;
            color: #2d3748;
        }

        .action-buttons {
            text-align: center;
            margin-top: 40px;
        }

        .btn {
            padding: 15px 40px;
            margin: 0 10px;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s;
        }

        .btn-print {
            background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
            color: white;
            box-shadow: 0 4px 15px rgba(72, 187, 120, 0.4);
        }

        .btn-print:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 25px rgba(72, 187, 120, 0.6);
        }

        .btn-back {
            background: linear-gradient(135deg, #718096 0%, #4a5568 100%);
            color: white;
            box-shadow: 0 4px 15px rgba(113, 128, 150, 0.4);
        }

        .btn-back:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 25px rgba(113, 128, 150, 0.6);
        }

        .watermark {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-45deg);
            font-size: 80px;
            color: rgba(102, 126, 234, 0.03);
            font-weight: 900;
            pointer-events: none;
            z-index: 0;
        }

        .card-content {
            position: relative;
            z-index: 1;
        }

        .badge {
            display: inline-block;
            padding: 5px 15px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <div class="id-card-wrapper">
        <div class="id-card">
            <div class="watermark">LPU</div>
            <div class="card-content">
                <div class="id-card-header">
                    <div class="university-logo">LPU</div>
                    <h1 class="university-name">Lovely Professional University</h1>
                    <p class="university-subtitle">Phagwara, Punjab, India</p>
                </div>

                <div class="id-card-body">
                    <div class="student-photo-container">
                        @if (Model.ProfileImage != null)
                        {
                            var base64 = Convert.ToBase64String(Model.ProfileImage);
                            var imgSrc = $"data:image/{Model.ImageExtension?.TrimStart('.')};base64,{base64}";
                            <img src="@imgSrc" alt="@Model.FullName" class="student-photo" />
                        }
                        else
                        {
                            <div class="student-photo" style="display: flex; align-items: center; justify-content: center; color: #a0aec0; font-weight: bold; font-size: 48px;">
                                @Model.FullName?.Substring(0, 1)
                            </div>
                        }
                    </div>

                    <div class="student-id-number">
                        LPU@(currentYear)@(Model.StudentId.ToString("D5"))
                    </div>

                    <div class="info-section">
                        <div class="info-label">Student Name</div>
                        <div class="info-value">@Model.FullName</div>
                    </div>

                    <div class="info-section">
                        <div class="info-label">Course</div>
                        <div class="info-value">@Model.CourseApplied</div>
                    </div>

                    <div class="info-section">
                        <div class="info-label">Date of Birth</div>
                        <div class="info-value">@Model.DOB?.ToString("dd MMM yyyy")</div>
                    </div>

                    <div class="info-section">
                        <div class="info-label">Gender</div>
                        <div class="info-value">@Model.Gender</div>
                    </div>

                    <div class="info-section">
                        <div class="info-label">Contact</div>
                        <div class="info-value">@Model.Mobile</div>
                    </div>

                    <div class="info-section">
                        <div class="info-label">Email</div>
                        <div class="info-value" style="font-size: 13px;">@Model.Email</div>
                    </div>
                </div>

                <div class="id-card-footer">
                    <div class="validity">
                        <strong>Valid:</strong> @currentYear - @validUntil
                    </div>
                    
                    <div class="signature-section">
                        <div class="signature">
                            <div class="signature-line">Student</div>
                        </div>
                        <div class="signature">
                            <div class="signature-line">Authority</div>
                        </div>
                    </div>

                    <div class="barcode">
                        ||||| |||| ||| |||| |||||
                    </div>
                    
                    <div class="badge">OFFICIAL ID CARD</div>
                </div>
            </div>
        </div>

        <div class="action-buttons no-print">
            <button onclick="window.print()" class="btn btn-print">🖨️ Print ID Card</button>
            <a href="/Student" class="btn btn-back">← Back to List</a>
        </div>
    </div>
</body>
</html>
