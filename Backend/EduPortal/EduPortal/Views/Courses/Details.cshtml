@model EduPortal.Models.Course

@{
    ViewData["Title"] = "Details";
}

<h1>Course Details</h1>

<div>
    <h4>Course Information</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Credits)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Credits)
        </dd>
    </dl>

    <h4 class="mt-4">Enrolled Students</h4>
    @if (Model.Students != null && Model.Students.Any())
    {
        <ul class="list-group col-sm-6">
            @foreach (var student in Model.Students)
            {
                <li class="list-group-item">
                    <strong>@student.FullName</strong> (@student.Email)
                </li>
            }
        </ul>
    }
    else
    {
        <p class="text-muted">No students are currently enrolled in this course.</p>
    }
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.CourseId" class="btn btn-primary">Edit</a> |
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>