<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Employee Application</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        .custom-header { background-color: #0056b3; color: white; padding: 15px; text-align: center; margin-bottom: 20px; }
        .custom-footer { background-color: #f8f9fa; border-top: 1px solid #e7e7e7; padding: 15px; text-align: center; position: fixed; bottom: 0; width: 100%; }
        .main-content { margin-bottom: 60px; /* Space for footer */ }
    </style>
</head>
<body>
    
    <header class="custom-header">
        <h2>Employee Management Portal</h2>

        <div style="margin-top: 10px;">
            <a asp-controller="Home" asp-action="Index" class="btn btn-light btn-sm">Home</a>
            <a asp-controller="Employee" asp-action="Create" class="btn btn-warning btn-sm ms-2">Add New Employee</a>
        </div>
    </header>

    <div class="container main-content">
        @RenderBody()
    </div>

    <footer class="custom-footer">
        <p>&copy; @DateTime.Now.Year - EmployeeApplication | Confidential</p>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>