@model IEnumerable<LPUID.Models.Student>

@{
    ViewData["Title"] = "Admin Dashboard - All Students";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary">Student Directory</h2>
            <p class="text-muted">Master list of all LPUID applications.</p>
        </div>
        <div>
            <a asp-action="Admission" class="btn btn-success">+ New Application</a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th class="ps-4">Full Name</th>
                            <th>App Number</th>
                            <th>Course</th>
                            <th>Hostel Allocation</th>
                            <th>Generated ID</th>
                            <th class="text-center pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var student in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@student.FullName</td>
                                    <td>@student.ApplicationNumber</td>
                                    <td><span class="badge bg-secondary">@student.Course</span></td>
                                    <td>
                                        @if (student.Hostel != null)
                                        {
                                            <span class="text-success fw-bold">@student.Hostel.BlockName - @student.Hostel.RoomNumber</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Day Scholar</span>
                                        }
                                    </td>
                                    <td>
                                        @if (student.IdCard != null)
                                        {
                                            <span class="font-monospace">@student.IdCard.UniqueCardNumber</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger small">Pending</span>
                                        }
                                    </td>
                                    <td class="text-center pe-4">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Dashboard" asp-route-id="@student.Id" class="btn btn-sm btn-outline-primary" title="View Dashboard">
                                                View
                                            </a>
                                            @if (student.IdCard != null)
                                            {
                                                <a asp-action="IdCard" asp-route-id="@student.Id" class="btn btn-sm btn-outline-dark" target="_blank" title="Print ID Card">
                                                    Print ID
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    No students have applied yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>