@{
    ViewBag.Title = "Lazy Loading Products";
}

<h2>AdventureWorks Products</h2>

<div id="product-list" class="row"></div>

<div id="loading" style="display:none; text-align:center; padding: 20px;">
    <i>Loading more products...</i>
</div>

@section scripts {
    <script>
        let currentPage = 1;
        const pageSize = 20; // Number of items per load
        let isLoading = false;
        let hasMoreData = true;

        // Load initial data on page load
        document.addEventListener("DOMContentLoaded", () => {
            loadProducts();
        });

        // Detect scrolling
        window.addEventListener("scroll", () => {
            // Check if we hit the bottom of the page
            if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 100) {
                if (!isLoading && hasMoreData) {
                    currentPage++;
                    loadProducts();
                }
            }
        });

        function loadProducts() {
            isLoading = true;
            document.getElementById("loading").style.display = "block";

            // Fetch data from our Controller
            fetch(`/Product/LoadMoreProducts?pageNumber=${currentPage}&pageSize=${pageSize}`)
                .then(response => response.json())
                .then(data => {
                    const productList = document.getElementById("product-list");

                    if (data.length === 0) {
                        hasMoreData = false; // Stop trying to load if we reached the end
                        document.getElementById("loading").innerHTML = "<b>No more products.</b>";
                        return;
                    }

                    // Loop through data and create HTML elements
                    data.forEach(product => {
                        const div = document.createElement("div");
                        div.className = "col-md-4";
                        div.style = "border: 1px solid #ddd; padding: 15px; margin-bottom: 10px;";
                        div.innerHTML = `
                            <h4>${product.Name}</h4>
                            <p>ID: ${product.ProductID}</p>
                            <p>Number: ${product.ProductNumber}</p>
                        `;
                        productList.appendChild(div);
                    });

                    isLoading = false;
                    document.getElementById("loading").style.display = "none";
                })
                .catch(error => {
                    console.error("Error fetching data:", error);
                    isLoading = false;
                });
        }
    </script>
}