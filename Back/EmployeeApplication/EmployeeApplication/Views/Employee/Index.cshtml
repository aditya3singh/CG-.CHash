@model IEnumerable<EmployeeApplication.Models.Employee>

@{
    ViewBag.Title = "Employee Directory";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Employee Directory</h2>
        <div>
            <a asp-action="Create" class="btn btn-primary">Add New Employee</a>
            <a asp-action="DownloadData" class="btn btn-success">Download CSV Data</a>
        </div>
    </div>
    <hr />

    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Age</th>
                <th>City</th>
                <th>Address</th>
                <th>Aadhar Card</th>
                <th>Date of Birth</th>
                <th>Salary</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>@item.Age</td>
                        <td>@item.City</td>
                        <td>@item.Address</td>
                        <td>@item.AadharCard</td>
                        <td>@item.DOB.ToShortDateString()</td>
                        <td>₹@item.Salary.ToString("0.00")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-3">
                        No employees found in the database. Click "Add New Employee" to get started.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>